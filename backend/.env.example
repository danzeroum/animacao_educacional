# Forja — variáveis de ambiente (copie para .env e preencha; NUNCA commite o .env)

# DeepSeek — grant único de ~5M tokens no signup, sem cartão. OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Provedor de imagem:
#   pollinations  → grátis, sem chave/cartão (DEFAULT, recomendado)
#   gemini        → Gemini 2.5 Flash Image (exige billing/saldo no projeto Google)
IMAGE_PROVIDER=pollinations
POLLINATIONS_MODEL=flux

# Só usado se IMAGE_PROVIDER=gemini:
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Raiz do repositório animacao_educacional (onde os objetos são gravados).
# Default: dois níveis acima de backend/app.
REPO_ROOT=

# Pipeline
FORJA_MAX_TENTATIVAS=3
FORJA_DB=./forja.db

# GitHub — o nó deploy faz git push + abre o PR via API REST com este token.
GITHUB_REPO=danzeroum/animacao_educacional
GITHUB_BASE_BRANCH=main
GITHUB_TOKEN=                 # PAT com escopo de PR (repo). Sem token → push-only.

# Segurança: dry-run NÃO faz git mutável nem abre PR (default).
# Em produção local, defina FORJA_DRY_RUN=false para publicar de verdade.
FORJA_DRY_RUN=true

# Forja — variáveis de ambiente (copie para .env e preencha; NUNCA commite o .env)

# DeepSeek — grant único de ~5M tokens no signup, sem cartão. OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google AI Studio (Gemini) — free tier de imagem, sem cartão (~500 img/dia).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Raiz do repositório animacao_educacional (onde os objetos são gravados).
# Default: dois níveis acima de backend/app.
REPO_ROOT=

# Pipeline
FORJA_MAX_TENTATIVAS=3
FORJA_DB=./forja.db

# GitHub (deploy abre PR via MCP no runtime do Claude Code; o backend só prepara o commit/branch)
GITHUB_REPO=danzeroum/animacao_educacional
GITHUB_BASE_BRANCH=main
